# Copy to deploy/config.env and fill in. config.env is git-ignored.
PROJECT_ID=your-project-id
REGION=asia-southeast1          # Singapore, closest to Thailand
ZONE=asia-southeast1-b
NETWORK=default
SUBNET=default
VM_NAME=obs-vm
VM_TYPE=e2-medium
REPO=health
API_SERVICE=health-api
WEB_SERVICE=health-web
WAITING_ROOM_ADMIT_PER_SEC=20
RATE_LIMIT_PER_MIN=60
MAX_INSTANCES=10
ADMIN_EMAILS=                   # comma-separated emails allowed to call /admin/usage
